{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "outlook-mail-extractor",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
